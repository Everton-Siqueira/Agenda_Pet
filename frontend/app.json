{
  "expo": {
    "name": "Agenda Pet",
    "slug": "agenda-pet",
    "scheme": "agendapet",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agendapet.app"
    },
    "android": {
      "package": "com.agendapet.app",
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf0513d7-3745-42c3-8982-5e2d57c1cf5b"
      }
    }
  }
}
